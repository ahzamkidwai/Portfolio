# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub (public username used for client-side API calls; no token required
# for the read-only public endpoints this project uses)
NEXT_PUBLIC_GITHUB_USERNAME=ahzamkidwai

# Contact form email delivery — plug in any provider (Resend, SendGrid,
# Postmark, Nodemailer + SMTP, etc.) inside src/app/api/contact/route.ts.
# Keep all of these server-side only; never prefix with NEXT_PUBLIC_.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_TO_ADDRESS=
